knitr::opts_chunk$set(echo = TRUE)
#Import the data and calculate the mean for each group.
reg_data <- read.csv("regdata.csv", header = TRUE)
aggregate(reg_data$y, list(reg_data$site), FUN = mean)
#We declare the number of iterations for the Gibbs sampler.
#The first 1000 are for burn-in, and 5000 will be used as
#posterior samples.
set.seed(100)
iter <- 6000
#Specify hyper-parameters.
sigma <- 0.85
a <- 1
b <- 1
#Define the group responses and predictors.
group_1_y <- reg_data[reg_data$site == 1, ]$y
group_2_y <- reg_data[reg_data$site == 2, ]$y
group_3_y <- reg_data[reg_data$site == 3, ]$y
group_4_y <- reg_data[reg_data$site == 4, ]$y
group_5_y <- reg_data[reg_data$site == 5, ]$y
group_1_x <- reg_data[reg_data$site == 1, ]$x
group_2_x <- reg_data[reg_data$site == 2, ]$x
group_3_x <- reg_data[reg_data$site == 3, ]$x
group_4_x <- reg_data[reg_data$site == 4, ]$x
group_5_x <- reg_data[reg_data$site == 5, ]$x
#Define two vectors holding all the y and x data. This will
#be used in the calculation of the distribution of beta.
entire_y <- reg_data$y
entire_x <- reg_data$x
#The groups are balanced, with each having 10 entries.
n <- 10
#Set up vectors to hold the samples. We use the prior means as the
#initial guess. In all cases, the prior mean is 0, except for the
#case of tau^(-2). In this case the mean is 1.
alpha_1 <- rep(0,iter)
alpha_2 <- rep(0,iter)
alpha_3 <- rep(0,iter)
alpha_4 <- rep(0,iter)
alpha_5 <- rep(0,iter)
beta <- rep(0,iter)
mu <- rep(0,iter)
tau_sqrinv <- rep(0,iter)
tau_sqrinv[1] <- 1
for (i in 1:(iter-1)){
#We start with the alphas.
#We only need to calculate the variance of the alphas once due to balancing of the
#groups.
alpha_var <- 1/(n/sigma^2 + tau_sqrinv[i])
#We calculate the means for each alpha
alpha_1_mean <- ((1/sigma^2)*sum(group_1_y) - (1/sigma^2)*beta[i]*sum(group_1_x) +
mu[i]*tau_sqrinv[i])*alpha_var
alpha_2_mean <- ((1/sigma^2)*sum(group_2_y) - (1/sigma^2)*beta[i]*sum(group_2_x) +
mu[i]*tau_sqrinv[i])*alpha_var
alpha_3_mean <- ((1/sigma^2)*sum(group_3_y) - (1/sigma^2)*beta[i]*sum(group_3_x) +
mu[i]*tau_sqrinv[i])*alpha_var
alpha_4_mean <- ((1/sigma^2)*sum(group_4_y) - (1/sigma^2)*beta[i]*sum(group_4_x) +
mu[i]*tau_sqrinv[i])*alpha_var
alpha_5_mean <- ((1/sigma^2)*sum(group_5_y) - (1/sigma^2)*beta[i]*sum(group_5_x) +
mu[i]*tau_sqrinv[i])*alpha_var
#Draw a sample for each of the alphas.
alpha_1[i+1] <- rnorm(1, mean = alpha_1_mean, sd = sqrt(alpha_var))
alpha_2[i+1] <- rnorm(1, mean = alpha_2_mean, sd = sqrt(alpha_var))
alpha_3[i+1] <- rnorm(1, mean = alpha_3_mean, sd = sqrt(alpha_var))
alpha_4[i+1] <- rnorm(1, mean = alpha_4_mean, sd = sqrt(alpha_var))
alpha_5[i+1] <- rnorm(1, mean = alpha_5_mean, sd = sqrt(alpha_var))
#Next we calculate the mean and variance for mu.
mu_var <- 1/(5*tau_sqrinv[i] + 1)
mu_mean <- tau_sqrinv[i]*(alpha_1[i+1] + alpha_2[i+1] +
alpha_3[i+1] + alpha_4[i+1] + alpha_5[i+1])*mu_var
mu[i+1] <- rnorm(1, mean = mu_mean, sd = sqrt(mu_var))
#Then we calculate the mean and variance for beta
beta_var <- 1/((1/sigma^2)*sum(entire_x^2) + 1)
beta_mean <- beta_var*((1/sigma^2)*sum(entire_x*entire_y) -
(1/sigma^2)*alpha_1[i+1]*sum(group_1_x) -
(1/sigma^2)*alpha_2[i+1]*sum(group_2_x) -
(1/sigma^2)*alpha_3[i+1]*sum(group_3_x) -
(1/sigma^2)*alpha_4[i+1]*sum(group_4_x) -
(1/sigma^2)*alpha_5[i+1]*sum(group_5_x))
#...and draw a sample for beta
beta[i+1] <- rnorm(1, mean = beta_mean, sd = sqrt(beta_var))
#Lastly we calculate the parameters for tau^(-2)
tau_sqrinv_shape <- 5/2 + a
tau_sqrinv_rate <- (1/2)*((alpha_1[i+1] - mu[i+1])^2 +
(alpha_2[i+1] - mu[i+1])^2 + (alpha_3[i+1] - mu[i+1])^2
+ (alpha_4[i+1] - mu[i+1])^2 + (alpha_5[i+1] - mu[i+1])^2) + b
tau_sqrinv[i+1] <- rgamma(1,shape = tau_sqrinv_shape, rate = tau_sqrinv_rate)
}
mean(alpha_1[1001:6000]) + mean(beta[1001:6000])*mean(group_1_x)
mean(alpha_2[1001:6000]) + mean(beta[1001:6000])*mean(group_2_x)
mean(alpha_3[1001:6000]) + mean(beta[1001:6000])*mean(group_3_x)
mean(alpha_4[1001:6000]) + mean(beta[1001:6000])*mean(group_4_x)
mean(alpha_5[1001:6000]) + mean(beta[1001:6000])*mean(group_5_x)
#We plot the ACFs for alpha_2, alpha_5, mu, and tau_sqrinv
#(after the requested burn-in of 1000 iterations).
acf(alpha_2[1001:5000], main='Gibbs Samples for alpha_2')
acf(alpha_5[1001:5000], main='Gibbs Samples for alpha_5')
acf(mu[1001:5000], main='Gibbs Samples for mu')
acf(tau_sqrinv[1001:5000], main='Gibbs Samples for tau_sqrinv')
#We make trace plots for alpha_2, alpha_5, mu, and tau_sqrinv
plot(alpha_2[1001:5000], main='Trace plot for alpha_2', type = "l",ylab = 'Gibbs Draw')
plot(alpha_5[1001:5000], main='Trace plot for alpha_5', type = "l",ylab = 'Gibbs Draw')
plot(mu[1001:5000], main='Trace plot for mu', type = "l",ylab = 'Gibbs Draw')
plot(tau_sqrinv[1001:5000]^(-2), main='Trace plot for tau_sqr', type = "l",ylab = 'Gibbs Draw')
#We plot the ACFs for alpha_2, alpha_5, mu, and tau_sqrinv
#(after the requested burn-in of 1000 iterations).
acf(alpha_2[1001:5000], main='Gibbs Samples for alpha_2')
acf(alpha_5[1001:5000], main='Gibbs Samples for alpha_5')
acf(mu[1001:5000], main='Gibbs Samples for mu')
acf(tau_sqrinv[1001:5000], main='Gibbs Samples for tau_sqrinv')
#We make trace plots for alpha_2, alpha_5, mu, and tau_sqrinv
plot(alpha_2[1001:5000], main='Trace plot for alpha_2', type = "l",ylab = 'Gibbs Draw')
plot(alpha_5[1001:5000], main='Trace plot for alpha_5', type = "l",ylab = 'Gibbs Draw')
plot(mu[1001:5000], main='Trace plot for mu', type = "l",ylab = 'Gibbs Draw')
plot(tau_sqrinv[1001:5000]^(-1), main='Trace plot for tau_sqr', type = "l",ylab = 'Gibbs Draw')
#Construct quantile based 95\% credible intervals for tau^2 and beta
quantile(tau_sqrinv[1001:5000]^(-2), c(0.025,0.975))
quantile(beta[1001:5000], c(0.025,0.975))
#Construct quantile based 95\% credible intervals for tau^2 and beta
quantile(tau_sqrinv[1001:5000]^(-1), c(0.025,0.975))
quantile(beta[1001:5000], c(0.025,0.975))
