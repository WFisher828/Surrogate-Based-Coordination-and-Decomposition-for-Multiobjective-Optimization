sparrow <- read.table("http://www2.stat.duke.edu/~pdh10/FCBS/Exercises/msparrownest.dat")
set.seed(100)
#Instantiate the standard deviations for \alpha and \beta. These are for the
#case where the sd is 1
tau_a_1 <- 1
tau_b_1 <- 1
#Instantiate the standard deviations for \alpha and \beta when we select
#tau_a = 0.75 and tau_b = 0.105
tau_a_true <- 0.75
tau_b_true <- 0.105
#Declare the two x values for which we will make histograms.
x_min <- 10
x_max <- 15
#Sample \alpha and \beta when sd = 1.
alpha_samp_1 <- rnorm(10000, mean = 0, sd = tau_a_1)
beta_samp_1 <- rnorm(10000, mean = 0, sd = tau_b_1)
#Sample \alpha and \beta when tau_a = 0.75 and tau_b = 0.105
alpha_samp_true <- rnorm(10000, mean = 0, sd = tau_a_true)
beta_samp_true <- rnorm(10000, mean = 0, sd = tau_b_true)
#Create theta = P(y = 1 | alpha, beta, x) values for x_min and x_max cases.
#This is when sd = 1
theta_min_1 <- exp(alpha_samp_1 + x_min*beta_samp_1)/
(1 + exp(alpha_samp_1 + x_min*beta_samp_1))
theta_max_1 <- exp(alpha_samp_1 + x_max*beta_samp_1)/
(1 + exp(alpha_samp_1 + x_max*beta_samp_1))
#Create theta = P(y=1 | alpha, beta, x) values for x_min and x_max cases.
#This is when tau_a = 0.75 and tau_b = 0.105.
theta_min_true <- exp(alpha_samp_true + x_min*beta_samp_true)/
(1 + exp(alpha_samp_true + x_min*beta_samp_true))
theta_max_true <- exp(alpha_samp_true + x_max*beta_samp_true)/
(1 + exp(alpha_samp_true + x_max*beta_samp_true))
#Plot histograms for the two cases (sd = 1).
hist(theta_min_1,main = 'Theta for x = 10, tau_a = tau_b = 1',
xlab = 'Theta value')
hist(theta_max_1,main = 'Theta for x = 15, tau_a = tau_b = 1',
xlab = 'Theta value')
#Plot histograms for the two cases (tau_a = 0.75, tau_b = 0.105)
hist(theta_min_true,main = 'Theta for x = 10, tau_a = 0.75 tau_b = 0.105',
xlab = 'Theta value')
hist(theta_max_true,main = 'Theta for x = 15, tau_a = 0.75 tau_b = 0.105',
xlab = 'Theta value')
