modAR2 <- arima(lakehurondetrend,order = c(2,0,0))
modAR1
modAR2
Box.test(modAR1$residuals, lag = 10, type = "Ljung-Box", fitdf = 1)
Box.test(modAR2$residuals, lag = 10, type = "Ljung-Box", fitdf = 2)
#It appears that the AR(2) model is the one we want
#to use for the detrended data because the AIC is lower and
#it sufficiently explains the error correlation structure
#according to the Ljung-Box test.
#We fit three ARIMA models with first and second order differencing,
#AR(2) components, and one with first order differencing and AR(1)
#component.
moddiffAR2 <- arima(LakeHuron,order = c(2,1,0))
moddiff2AR2 <- arima(LakeHuron,order = c(2,2,0))
moddiffAR1 <- arima(LakeHuron,order = c(1,1,0))
moddiffAR2
moddiff2AR2
moddiffAR1
#Check whether the two models sufficiently explain the
#autocovariance structure.
Box.test(moddiffAR2$residuals, lag = 10, type = "Ljung-Box", fitdf = 2)
Box.test(moddiff2AR2$residuals, lag = 10, type = "Ljung-Box", fitdf = 2)
Box.test(moddiffAR1$residuals, lag = 10, type = "Ljung-Box", fitdf = 1)
#We will pick the ARIMA(2,1,0) model, as it has a lower AIC
#and explains the autocorrelation structure sufficiently.
# Years predicted into the future
h <- 5
## Define the prediction time
fyear <- 1967 + (1:h)
## Predict 'h' years into the future using the ARMA(2,0) model
#with detrending.
AR2.forecast <- predict(modAR2, h)
AR2.forecast$pred; AR2.forecast$se
# Predict 'h' years into the future using the ARIMA(2,1,0) model.
DiffAR2.forecast <- predict(moddiffAR2, h)
DiffAR2.forecast$pred; DiffAR2.forecast$se
## define the forecast variable for ARMA(2,0) model with detrending.
forecast_AR2 <- AR2.forecast$pred + (lm$coefficients[1] + lm$coefficients[2]*fyear)
## The plus or minus value is the z critical value
## times the standard error for the forecast
me_AR2 <- qnorm(0.975) * AR2.forecast$se
lower_AR2 <- forecast_AR2 - me_AR2
upper_AR2 <- forecast_AR2 + me_AR2
## define the forecast variable for ARIMA(2,1,0) model.
forecast_DiffAR2 <- DiffAR2.forecast$pred
## The plus or minus value is the z critical value
## times the standard error for the forecast
me_DiffAR2 <- qnorm(0.975) * DiffAR2.forecast$se
lower_DiffAR2 <- forecast_DiffAR2 - me_DiffAR2
upper_DiffAR2 <- forecast_DiffAR2 + me_DiffAR2
## Show the data for 1875 onwards (up to the final prediction year)
plot(LakeHuron, type = "l",
xlim = c(1875,max(fyear)), col = "grey", xlab = "year", ylab = "Lake Huron Depth")
title("Forecasts for the Depth of Lake Huron")
## Add the BLUP, along with the prediction limits
lines(fyear, forecast_AR2, lwd = 2,col = "red")
lines(fyear, lower_AR2, lty = 2, lwd = 2,col = "red")
lines(fyear, upper_AR2, lty =2 , lwd = 2, col = "red")
lines(fyear, forecast_DiffAR2, lwd = 2, col = "blue")
lines(fyear, lower_DiffAR2, lty = 2, lwd = 2, col = "blue")
lines(fyear, upper_DiffAR2, lty =2 , lwd = 2, col = "blue")
legend(1880, 577.5,legend=c("ARMA(2,0)", "ARIMA(2,1,0)"),
fill = c("red","blue")
)
