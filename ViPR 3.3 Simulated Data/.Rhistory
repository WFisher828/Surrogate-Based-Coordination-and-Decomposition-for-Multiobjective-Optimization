library(TSA)
library(forecast)
co2 <- read.csv("co2_NOAA.csv")
#We start by fitting harmonic regression and then we
#will conduct the ARMA.
co2_ts <- ts(co2,start = c(1958,3), frequency = 12)
co2_ts_avg <- co2_ts[,4]
time <- as.numeric(time(co2_ts_avg))
#We set up the harmonics
co2_harmonics <- harmonic(co2_ts_avg, 6)
regress_mod <- lm(co2_ts_avg ~ poly(co2$decimal.date, 8) + co2_harmonics)
summary(regress_mod)
plot(time,co2_ts_avg,type = "l",xlab = "Time", ylab = "Average")
lines(time, regress_mod$fitted.values, col = "blue", lty = 2)
#get list of residuals from harmonic regression
res <- resid(regress_mod)
#produce residual vs. fitted plot
plot(time, res, xlab = "Time", ylab = "Residuals",type = "l")
#add a horizontal line at 0
abline(0,0)
#Observe the acf and pacf of the data after removing the
#seasonal trend
acf(res,lag.max = 40)
pacf(res,lag.max = 40)
#It appears as though a AR(2) or maybe AR(1) model may be
#appropriate
harm_mod_AR2 <- arima(res,order = c(2,0,0))
harm_mod_AR2
harm_mod_AR1 <- arima(res,order = c(1,0,0))
harm_mod_AR1
#Neither model adequately explains the correlation structure.
Box.test(harm_mod_AR2$residuals, lag = 40, type = "Ljung-Box", fitdf = 2)
Box.test(harm_mod_AR1$residuals, lag = 40, type = "Ljung-Box", fitdf = 2)
#Let's try auto.arima
auto_arma = auto.arima(res, seasonal = FALSE)
auto_arma
#Model still does not sufficiently explain autocorrelation structure.
#Only marginally better than AR(2) model in terms of AIC.
Box.test(auto_arma$residuals,lag=40,type="Ljung-Box", fitdf = 6)
#We move on to SARIMA modeling.
diff_co2 <- diff(co2_ts_avg)
sarima_mod_AR1_Diff1_SAR1 <- arima(diff_co2,order = c(1,0,0), seasonal = list(order = c(1, 0, 0), period = 12))
sarima_mod_AR1_Diff1_SAR1
Box.test(sarima_mod_AR1_Diff1_SAR1$residuals, lag = 40, type = "Ljung-Box", fitdf = 2)
sarima_mod_AR2_Diff1_SAR1 <- arima(diff_co2,order = c(2,0,0), seasonal = list(order = c(1, 0, 0), period = 12))
sarima_mod_AR2_Diff1_SAR1
Box.test(sarima_mod_AR2_Diff1_SAR1$residuals, lag = 40, type = "Ljung-Box", fitdf = 3)
sarima_mod_AR2_Diff1_SAR2 <- arima(diff_co2,order = c(2,0,0), seasonal = list(order = c(2, 0, 0), period = 12))
sarima_mod_AR2_Diff1_SAR2
Box.test(sarima_mod_AR2_Diff1_SAR2$residuals, lag = 40, type = "Ljung-Box", fitdf = 3)
#It seems like none of these are working well. We will use auto_arima()
auto_sarima <- auto.arima(co2_ts_avg)
auto_sarima
Box.test(auto_sarima$residuals, lag = 40, type = "Ljung-Box", fitdf = 6)
View(co2)
